{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cofy-x/axrun/schemas/resolved-episode-v1.schema.json",
  "title": "ResolvedEpisode v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "task_id",
    "task_digest",
    "base_commit",
    "prompt_file",
    "inference_environment_id",
    "verification_environment_id"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "episode_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "task_digest": { "type": "string", "minLength": 1 },
    "base_commit": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
    "prompt_file": { "type": "string", "minLength": 1 },
    "inference_environment_id": { "type": "string", "minLength": 1 },
    "verification_environment_id": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "default": {}
    }
  }
}
