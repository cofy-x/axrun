{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cofy-x/axrun/schemas/resolved-episode-v1.schema.json",
  "title": "ResolvedEpisode v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "task_id", "seed_digest", "base_commit", "prompt_file", "inference_environment_id", "verification_environment_id", "harness", "verifier"],
  "properties": {
    "schema_version": { "const": 1 },
    "episode_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "seed_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "base_commit": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
    "prompt_file": { "type": "string", "minLength": 1 },
    "inference_environment_id": { "type": "string", "minLength": 1 },
    "verification_environment_id": { "type": "string", "minLength": 1 },
    "harness": { "$ref": "#/$defs/harness" },
    "verifier": { "$ref": "#/$defs/verifier" },
    "inference_resources": { "$ref": "#/$defs/resources" },
    "verification_resources": { "$ref": "#/$defs/resources" },
    "metadata": { "type": "object", "additionalProperties": { "type": "string" }, "default": {} }
  },
  "$defs": {
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "version"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "config": { "type": "object", "default": {} }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "version"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "config": { "type": "object", "default": {} }
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "request_cpu": { "type": "string" }, "request_memory": { "type": "string" }, "request_ephemeral_storage": { "type": "string" },
        "limit_cpu": { "type": "string" }, "limit_memory": { "type": "string" }, "limit_ephemeral_storage": { "type": "string" }
      }
    }
  }
}
