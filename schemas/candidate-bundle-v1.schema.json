{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cofy-x/axrun/schemas/candidate-bundle-v1.schema.json",
  "title": "CandidateBundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_id", "task_id", "task_digest", "base_commit", "inference_run_id", "harness", "harness_version", "files", "digest"],
  "properties": {
    "schema_version": { "const": 1 },
    "episode_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "task_digest": { "type": "string", "minLength": 1 },
    "base_commit": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
    "inference_run_id": { "type": "string", "minLength": 1 },
    "harness": { "type": "string", "minLength": 1 },
    "harness_version": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["declared_path", "bundle_path", "size_bytes", "sha256", "media_type"],
      "properties": {
        "declared_path": { "type": "string", "minLength": 1 }, "bundle_path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "media_type": { "type": "string" }
      }
    }
  }
}
